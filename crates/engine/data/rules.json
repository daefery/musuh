     " administrator",
     "enterprise admins",
     " /do"
    ]
   }
  },
  "simplified": "cabang 'accounts' dan filter '/add' tidak disertakan",
  "own": false,
  "hostSeg": null
 },
 {
  "id": "S06",
  "title": "Potensi pencurian kredensial dari LSASS",
  "sigmaTitle": "Potential Credential Dumping Activity Via LSASS",
  "level": "medium",
  "sid": "5ef9853e-4d0e-4a70-846f-a9ca37d876da",
  "path": "rules/windows/process_access/proc_access_win_lsass_memdump.yml",
  "src": "Sysmon",
  "eid": "10",
  "sel": {
   "TargetImage": {
    "endswith": [
     "\\lsass.exe"
    ]
   },
   "GrantedAccess": {
    "contains": [
     "0x1038",
     "0x1438",
     "0x143a",
     "0x1fffff"
    ]
   },
   "CallTrace": {
    "contains": [
     "dbgcore.dll",
     "dbghelp.dll",
     "kernel32.dll",
     "kernelbase.dll",
     "ntdll.dll"
    ]
   }
  },
  "simplified": "filter akun SYSTEM, THOR dan Sysmon tidak disertakan",
  "own": false,
  "hostSeg": null
 },
